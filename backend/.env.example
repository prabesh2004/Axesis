# Server
PORT=3000
NODE_ENV=production

# MongoDB (Atlas free tier — copy connection string from Atlas dashboard)
MONGODB_URI=

# JWT
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# CORS — set to your Netlify URL (comma-separate multiple origins)
# Example: https://your-site.netlify.app,http://localhost:8081
CORS_ORIGIN=https://your-site.netlify.app

# Groq API  (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter / StepFun  (https://openrouter.ai)
STEP_API_KEY=
STEP_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=

# Google Gemini  (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth (for login)
# Must match the OAuth Client ID used by the frontend.
GOOGLE_CLIENT_ID=
